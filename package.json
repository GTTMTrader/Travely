{
  "name": "travely",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:unit": "vitest run tests/unit",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-travely",
    "test:rules": "firebase emulators:exec --only firestore --project demo-travely \"vitest run tests/rules\"",
    "test:e2e": "playwright test e2e/sync.spec.ts",
    "icons": "node scripts/make-icons.mjs",
    "dev:demo": "vite --mode memory",
    "build:demo": "tsc -b && vite build --mode memory --outDir dist-demo",
    "test:ui": "playwright test e2e/ui.spec.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "build:preview": "node scripts/build-preview.mjs travely-preview.html"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "firebase": "^13.2.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.34.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
